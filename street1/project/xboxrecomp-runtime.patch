+static void emu_rts(dsp_core_t* dsp)
+{
+    uint32_t newpc = 0, newsr;
+
+    dsp_stack_pop(dsp, &newpc, &newsr);
+    dsp->pc = newpc;
+    dsp->cur_inst_len = 0;
+
+    dsp->instr_cycle += 2;
+}
