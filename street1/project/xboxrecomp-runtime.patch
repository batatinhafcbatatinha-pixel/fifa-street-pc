+
+static bool match_MMMRRR(uint32_t op)
+{
+    uint32_t RRR = (op >> 8) & BITMASK(3);
+    uint32_t MMM = (op >> 11) & BITMASK(3);
+    if (MMM == 0x6) {
+        return RRR == 0x0 || RRR == 0x4;
+    }
+    return true;
+}
