+static void emu_movec_imm(dsp_core_t* dsp)
+{
+    uint32_t numreg, value;
+
+    /* #xx,D1 */
+    numreg = dsp->cur_inst & BITMASK(6);
+    value = (dsp->cur_inst>>8) & BITMASK(8);
+    value &= BITMASK(registers_mask[numreg]);
